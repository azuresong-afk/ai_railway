# Настройки шлюза (ADR-0034): переменные AISEC_GATEWAY_*. Секретов здесь
# нет: ключ TLS, корень сервера и якорь пакетов передаёт systemd из
# /etc/aisec/credentials. После правки: systemctl restart aisec-gateway.
#
# Адрес по умолчанию — только 127.0.0.1, как публикация порта в compose.
AISEC_GATEWAY_LISTEN=127.0.0.1:8443
# Внутренний API сервера управления (mTLS): имя — из сертификата консоли.
AISEC_GATEWAY_SERVER=https://aisec.example.test:8445
