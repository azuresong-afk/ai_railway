# Настройки aisec-cli (ADR-0034), читает обёртка /usr/sbin/aisec-cli.
# Строка подключения владельца схемы — без пароля: пароль роли aisec_owner
# лежит в /etc/aisec/credentials/db-owner.pgpass и передаётся только
# процессу aisec-cli (у сервера, тоже пользователя aisec, его нет).
AISEC_DATABASE_URL=postgres://aisec_owner@127.0.0.1:5432/aisec?sslmode=disable
