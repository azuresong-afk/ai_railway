# Настройки сервера управления (ADR-0034): переменные AISEC_SERVER_* и
# строка подключения к СУБД. Секретов здесь нет и быть не должно: пароль
# роли aisec_server — в /etc/aisec/credentials/db-server.pgpass (его
# передаёт systemd, PGPASSFILE задан в юните). После правки:
# systemctl restart aisec-server.
#
# Адреса по умолчанию — только 127.0.0.1, как публикация портов в compose.
# Для доступа администраторов к консоли укажите адрес узла.
AISEC_SERVER_LISTEN=127.0.0.1:8444
AISEC_SERVER_INTERNAL_LISTEN=127.0.0.1:8445
# Своя СУБД заказчика на другом узле — sslmode=verify-full и sslrootcert.
AISEC_DATABASE_URL=postgres://aisec_server@127.0.0.1:5432/aisec?sslmode=disable
AISEC_SERVER_INTEGRITY_ACTION=alert
AISEC_SERVER_TRUSTED_PROXIES=
