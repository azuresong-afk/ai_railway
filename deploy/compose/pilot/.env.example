# Переменные установки пилота (compose.yaml). Скопируйте в .env рядом с
# compose.yaml и заполните. Секретов здесь нет и быть не должно: пароли,
# ключи и сертификаты — файлы в ${AISEC_DATA_DIR}/secrets и ${AISEC_DATA_DIR}/keys.

# Версия выпуска — тег образов aisec-server, aisec-gateway, aisec-cli.
AISEC_VERSION=0.3.0
# Репозиторий образов продукта: aisec (поставочные образы, make images) или
# реестр заказчика, куда они загружены. aisec-test — сборка с тестовым ключом
# манифеста, НЕ ДЛЯ ПИЛОТА (консоль покажет предупреждение).
AISEC_IMAGE_REPO=aisec
# Образ PostgreSQL: postgres (Docker Hub) или копия в реестре заказчика,
# например registry.example.ru/library/postgres. Версия и digest закреплены
# в compose.yaml.
AISEC_POSTGRES_IMAGE=postgres

# Каталог данных на хосте: ключи, секреты, БД, состояние шлюза, копии.
AISEC_DATA_DIR=/srv/aisec

# Пользователи хоста (ЗИ.5). Заполняет prepare-host.sh; значения ниже — пример.
AISEC_UID=990
AISEC_GID=990
AISEC_GW_UID=991
AISEC_GW_GID=991
AISEC_DB_UID=992
AISEC_DB_GID=992

# Имя сервера из сертификата консоли (secrets/console.crt): по нему
# администраторы открывают консоль, а шлюз проверяет сервер.
AISEC_CONSOLE_HOST=aisec.example.ru
# Адрес интерфейса хоста и порт консоли. 127.0.0.1 — только с самого хоста;
# для доступа администраторов укажите адрес хоста в сети управления.
AISEC_CONSOLE_BIND=127.0.0.1
AISEC_CONSOLE_PORT=8444
# Адрес и порт шлюза для приложений.
AISEC_GATEWAY_BIND=127.0.0.1
AISEC_GATEWAY_PORT=8443

# Сети доверенных обратных прокси через запятую (X-Forwarded-For); пусто — нет.
AISEC_TRUSTED_PROXIES=
# Реакция сервера на нарушение целостности: alert или stop.
AISEC_INTEGRITY_ACTION=alert

# Профиль db — PostgreSQL в этой установке. aisec-cli (профиль tools)
# запускается только командой docker compose run и в профили не включается.
# Своя СУБД заказчика: COMPOSE_PROFILES= (пусто), роли и БД — как в
# initdb/10-aisec-roles.sql, строки подключения ниже с sslmode=verify-full;
# пароль — только в passfile (secrets/db-*.pgpass), корень УЦ СУБД —
# дополнительным секретом (README.md, «Своя СУБД»).
COMPOSE_PROFILES=db
# AISEC_SERVER_DB_URL=postgres://aisec_server@db.example.ru:5432/aisec?sslmode=verify-full&sslrootcert=/run/secrets/db-ca&passfile=/run/secrets/db-server-pgpass
# AISEC_OWNER_DB_URL=postgres://aisec_owner@db.example.ru:5432/aisec?sslmode=verify-full&sslrootcert=/run/secrets/db-ca&passfile=/run/secrets/db-owner-pgpass
